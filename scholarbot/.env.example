# ScholarBot AI — Environment Variables Template
# Dapatkan API key GRATIS di: https://console.groq.com/keys
# Copy file ini ke .env dan masukkan key kamu:
#
# GROQ_API_KEY=gsk_your_key_here

# Optional server-side embeddings (no credentials = explicit keyword fallback)
# HF_TOKEN=hf_your_token_here
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_REVISION=provider-managed
# EMBEDDING_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2

# Pilot-selected lightweight default; alternatives: keyword, dense
# RETRIEVAL_METHOD=bm25
